# ==============================================================================
# OOPSIE Environment Configuration Reference
# Copy to .env or .env.local for local overrides.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Web Client (apps/web-demo)
# ------------------------------------------------------------------------------
# VITE_OOPSIE_API_URL:
# Controls how the browser client reaches the inference service.
# - Leave unset: Defaults to Offline Demo Mode (local rule simulation).
# - Relative path: Set to '/api' to route requests through the Vite dev-server proxy.
# - Direct origin: Set to 'http://127.0.0.1:8000' (client appends '/v1/analyze').
# - Full endpoint: Set to 'http://127.0.0.1:8000/v1/analyze'.
# VITE_OOPSIE_API_URL=http://127.0.0.1:8000

# VITE_OOPSIE_BACKEND_URL:
# Development proxy target used by Vite dev server to forward '/api/*' requests.
# MUST be an HTTP/HTTPS origin (host + port). NEVER pass a relative path or endpoint URL.
# Default: http://127.0.0.1:8000
# VITE_OOPSIE_BACKEND_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. Backend Inference Service (inference/api)
# ------------------------------------------------------------------------------
# OOPSIE_USE_MOCK_ENGINE:
# - '1': Uses MockInferenceEngine (instant canned response, no GPU or weights required).
# - '0': Uses Gemma4PilotEngine (requires PyTorch, CUDA GPU >= 15GB VRAM, and weights).
OOPSIE_USE_MOCK_ENGINE=1

# OOPSIE_CORS_ORIGINS:
# Comma-separated allowed origins for browser cross-origin requests.
OOPSIE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OOPSIE_MODEL_ID:
# Base model repository on Hugging Face (default: google/gemma-4-12b-it).
# OOPSIE_MODEL_ID=google/gemma-4-12b-it

# OOPSIE_ADAPTER_PATH:
# Filesystem path to fine-tuned LoRA adapter checkpoint.
# OOPSIE_ADAPTER_PATH=/path/to/oopsie-pilot-adapter

# OOPSIE_PROMPT_VERSION:
# System prompt condition: 'system_prompt_v2_enum_guided' (default) or 'system_prompt_v1'.
# OOPSIE_PROMPT_VERSION=system_prompt_v2_enum_guided
