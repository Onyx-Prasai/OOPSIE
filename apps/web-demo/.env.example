# ==============================================================================
# OOPSIE Web Demo Client Environment Configuration
# ==============================================================================

# VITE_OOPSIE_API_URL:
# Controls how the browser client reaches the inference service.
# - Leave unset: Defaults to Offline Demo Mode (local rule simulation).
# - Relative path: Set to '/api' to route requests through the Vite dev-server proxy.
# - Direct origin: Set to 'http://127.0.0.1:8000' (client appends '/v1/analyze').
# - Full endpoint: Set to 'http://127.0.0.1:8000/v1/analyze'.
# VITE_OOPSIE_API_URL=http://127.0.0.1:8000

# VITE_OOPSIE_BACKEND_URL:
# Development proxy target used by Vite dev server to forward '/api/*' requests.
# MUST be an HTTP/HTTPS origin (host + port). NEVER pass a relative path or endpoint URL.
# Default: http://127.0.0.1:8000
# VITE_OOPSIE_BACKEND_URL=http://127.0.0.1:8000
