{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Onyx-Prasai/OOPSIE/data/example-schema.json",
  "title": "OOPSIE Dataset Record",
  "description": "Full storage record containing input, metadata, provenance, and expected target report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "scenario_group",
    "provenance",
    "review",
    "model_input",
    "reference_annotations",
    "target_report"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(syn|rep|ext)-[a-z0-9]+-[0-9]{3}$",
      "description": "Unique identifier (e.g. syn-dep-001, rep-react-002)."
    },
    "scenario_group": {
      "type": "string",
      "minLength": 1,
      "description": "Cluster key linking variations of the same root issue to prevent train/test leakage."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["synthetic", "reproduced", "externally_sourced"]
        },
        "source_reference": {
          "type": "string",
          "description": "URL, issue reference, or reproduction repo path. Omit or leave empty if purely synthetic."
        },
        "license": {
          "type": "string",
          "description": "SPDX identifier (e.g. Apache-2.0, MIT) or 'Proprietary-Permissioned'. Defaults to Apache-2.0 for synthetic."
        },
        "reproduction_environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "os": { "type": "string" },
            "runtime": { "type": "string" },
            "package_manager": { "type": "string" }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "fix_tested"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["unreviewed", "in_review", "approved", "rejected"]
        },
        "reviewer": {
          "type": "string",
          "description": "Reviewer handle or name once reviewed."
        },
        "review_notes": {
          "type": "string"
        },
        "fix_tested": {
          "type": "boolean",
          "description": "True only if the proposed fix was verified in a real reproduction environment."
        }
      }
    },
    "model_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_error"],
      "properties": {
        "raw_error": {
          "type": "string",
          "minLength": 1,
          "description": "The exact error string, stack trace, or terminal log provided by the user."
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional user-provided context. All fields are optional.",
          "properties": {
            "language_or_framework": { "type": "string" },
            "runtime_or_versions": { "type": "string" },
            "code_excerpt": { "type": "string" },
            "environment": {
              "type": "string",
              "enum": ["local_development", "ci_build", "staging", "production", "unknown"]
            },
            "recent_changes": { "type": "string" }
          }
        }
      }
    },
    "reference_annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_cause", "reference_repair", "difficulty"],
      "description": "Human review annotations not exposed to the model during inference.",
      "properties": {
        "reference_cause": {
          "type": "string",
          "minLength": 1
        },
        "reference_repair": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "type": "string",
          "enum": ["easy", "medium", "hard"]
        }
      }
    },
    "target_report": {
      "$ref": "schema.json",
      "type": "object"
    }
  }
}
