{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OOPSIE Dataset Example",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "framework", "platform", "input_type", "raw_error", "cleaned_error",
    "expected_category", "expected_risk", "ground_truth_cause", "ground_truth_fix",
    "safe_repair_prompt", "verification_steps", "warnings", "difficulty",
    "source_type", "target_report"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "framework": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "input_type": { "type": "string", "enum": ["error_message", "stack_trace", "terminal_output", "build_log", "deployment_log"] },
    "raw_error": { "type": "string", "minLength": 1 },
    "cleaned_error": { "type": "string", "minLength": 1 },
    "expected_category": { "type": "string", "enum": ["dependency", "configuration", "environment_variables", "database", "authentication", "authorization", "network", "build", "deployment", "runtime", "typescript", "frontend", "other", "unknown"] },
    "expected_risk": { "type": "string", "enum": ["low", "medium", "high"] },
    "ground_truth_cause": { "type": "string", "minLength": 1 },
    "ground_truth_fix": { "type": "string", "minLength": 1 },
    "safe_repair_prompt": { "type": "string", "minLength": 1 },
    "verification_steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
    "source_type": { "type": "string", "enum": ["synthetic", "permissioned_anonymized"] },
    "target_report": { "type": "object" }
  }
}
