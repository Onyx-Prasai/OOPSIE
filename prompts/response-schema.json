{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OopsieReportSchema",
  "type": "object",
  "required": [
    "summary",
    "plain_english_explanation",
    "likely_causes",
    "category",
    "risk_level",
    "follow_up_questions",
    "repair_prompt",
    "verification_checklist",
    "safety_warnings"
  ],
  "properties": {
    "summary": { "type": "string" },
    "plain_english_explanation": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["dependency", "build", "environment_variables", "database", "deployment", "authentication", "api", "runtime", "cors", "syntax"]
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "likely_causes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "description": { "type": "string" }
        },
        "required": ["title", "confidence", "description"]
      }
    },
    "follow_up_questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "repair_prompt": { "type": "string" },
    "verification_checklist": {
      "type": "array",
      "items": { "type": "string" }
    },
    "safety_warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
