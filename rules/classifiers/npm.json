    { "category": "deployment",           "signatures": ["Build failed", "Command failed with exit code", "ENOENT", "Cannot read properties of undefined"] },
    { "category": "authentication",       "signatures": ["401", "403", "Unauthorized", "Invalid token", "Session expired", "JWT"] },
    { "category": "network",              "signatures": ["ECONNREFUSED", "ETIMEDOUT", "fetch failed", "Network Error", "CORS"] },
    { "category": "typescript",           "signatures": ["TS", "Type error", "is not assignable to type", "Property does not exist"] }
  ]
}
