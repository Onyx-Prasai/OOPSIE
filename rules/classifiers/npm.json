{
  "patterns": [
    { "category": "dependency",            "signatures": ["Module not found", "Cannot find module", "ERR_PNPM_NO_MATCHING_VERSION", "npm ERR! code ERESOLVE", "peer dep missing"] },
    { "category": "environment_variables", "signatures": ["undefined", "process.env", "NEXT_PUBLIC_", "Missing env", "getStaticProps"] },
