{
  "redaction_rules": [
    {
      "name": "Supabase Service Role Key",
      "regex": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\\.[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]+",
      "replacement": "[REDACTED_JWT_SECRET]"
    },
    {
      "name": "OpenAI/Anthropic API Keys",
      "regex": "(sk-[a-zA-Z0-9]{32,}|sk-ant-[a-zA-Z0-9_-]{32,})",
      "replacement": "[REDACTED_API_KEY]"
    },
    {
      "name": "Database Password URI",
      "regex": "postgres://[^:]+:([^@]+)@",
      "replacement": "postgres://user:[REDACTED_PASSWORD]@"
    }
  ]
}
